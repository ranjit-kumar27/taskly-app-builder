# Copy to `.env` (same folder) and fill in real values. `.env` is gitignored.
# Read by Spring Boot (spring.config.import in application.yaml) and by
# docker compose (services.docker-compose.yml) — keep KEY=VALUE, no quotes.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:9010/tasklyDB-test
DB_USERNAME=user
DB_PASSWORD=change-me

# --- AI (OpenRouter, OpenAI-compatible) ---
AI_API_KEY=sk-or-v1-your-key
AI_BASE_URL=https://openrouter.ai/api
# Paid (needs OpenRouter credit): openai/gpt-5.4-mini
# Free (50 req/day on free tier): cohere/north-mini-code:free, nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL=cohere/north-mini-code:free

# --- Auth --- (32+ random chars, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# --- MinIO (object storage) ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# --- Live preview --- (local = npm dev server on this machine, kubernetes = runner pods)
PREVIEW_MODE=local
